{
  "name": "riftbound-szabalykereso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data": "cd ../src && python3 build_data.py && python3 export_web.py && rm -f data.json",
    "dev": "vite",
    "build": "tsc -b && vite build && node ../scripts/check-dist.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:dashes": "node ../scripts/check-dashes.mjs",
    "bench": "rm -f bench-results.json && vitest bench --run --no-file-parallelism",
    "perf": "rm -f perf-results.json && PERF=1 playwright test --project=perf --reporter=line",
    "golden:capture": "rm -f /tmp/golden-capture.jsonl && vitest run -c vitest.capture.config.ts && node unit/golden/capture.mjs",
    "lint": "lint/node_modules/.bin/eslint src && npm run lint:deps",
    "lint:deps": "lint/node_modules/.bin/depcruise --config lint/.dependency-cruiser.cjs --ignore-known lint/known-violations.json src",
    "lint:deps:baseline": "lint/node_modules/.bin/depcruise --config lint/.dependency-cruiser.cjs --baseline lint/known-violations.json src",
    "knip": "knip",
    "lint:install": "npm ci --prefix lint",
    "lhci": "npx -y @lhci/cli@0.16.1 autorun"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.3",
    "knip": "^6.47.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
