{
  "name": "riftbound-szabalykereso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data": "cd ../src && python3 build_data.py && python3 export_web.py && rm -f data.json",
    "dev": "vite",
    "build": "tsc -b && vite build && SINGLE=1 vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:dashes": "node ../scripts/check-dashes.mjs",
    "bench": "rm -f bench-results.json && vitest bench --run --no-file-parallelism",
    "perf": "rm -f perf-results.json && PERF=1 playwright test --project=perf --reporter=line",
    "golden:capture": "rm -f /tmp/golden-capture.jsonl && vitest run -c vitest.capture.config.ts && node unit/golden/capture.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
